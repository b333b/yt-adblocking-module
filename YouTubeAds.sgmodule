#!name=Youtube (Music) Enhance (relay-free fork)
#!desc=适用于 Youtube & Youtube Music
#!arguments=屏蔽上传按钮:true,屏蔽选段按钮:true,屏蔽Shorts按钮:false,字幕翻译语言:off,启用调试模式:false
#!arguments-desc=- 屏蔽参数：[true, false] \n- 翻译参数：[语言代码, off] \n\n1. 语言代码遵循 Google Translate Languages Codes, 当填入 off 时关闭翻译\n2. 开启调试模式用于输出更多日志

# Auto-built relay-free fork of Maasea/sgmodule. Do not edit by hand.
# Upstream commit: 65075cdb388fc5e3094afd7e7314c67b243f3525 (2026-07-19T16:33:52+08:00)
# Scripts run inside relay-guard 1.0.0; network egress limited to: googlevideo.com, youtube.com, googleapis.com, ytimg.com, ggpht.com, gstatic.com


[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/b333b/yt-adblocking-module/main/Script/Youtube/youtube.response.js?v=c6c11c4c,argument="{"captionLang":"{{{字幕翻译语言}}}","blockUpload":{{{屏蔽上传按钮}}},"blockImmersive":{{{屏蔽选段按钮}}},"blockShorts":{{{屏蔽Shorts按钮}}},"debug":{{{启用调试模式}}}}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/b333b/yt-adblocking-module/main/Script/Youtube/youtube.request.js?v=b6c71fec,argument="{"captionLang":"{{{字幕翻译语言}}}"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/b333b/yt-adblocking-module/main/Script/Youtube/youtube.request.js?v=b6c71fec

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
