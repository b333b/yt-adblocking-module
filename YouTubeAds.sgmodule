#!name=YouTube — AdBlock
#!desc=Removes ads from YouTube and YouTube Music apps
#!arguments=Block_Upload_Button:true,Block_Clip_Button:true,Block_Shorts_Button:false,Subtitle_Translation_Language:off,Debug_Mode:false
#!arguments-desc=- Block options: [true, false] \n- Translation option: [language code, off] \n\n1. Language codes follow Google Translate language codes; set to off to turn translation off\n2. Debug mode writes more detailed logs

# Auto-built relay-free fork of Maasea/sgmodule. Do not edit by hand.
# Upstream commit: 65075cdb388fc5e3094afd7e7314c67b243f3525 (2026-07-19T16:33:52+08:00)
# Scripts run inside relay-guard 1.1.0; network egress limited to: googlevideo.com, youtube.com, googleapis.com, ytimg.com, ggpht.com, gstatic.com


[Script]
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/b333b/yt-adblocking-module/main/Script/Youtube/youtube.response.js?v=172a9ed8,argument="{"captionLang":"{{{Subtitle_Translation_Language}}}","blockUpload":{{{Block_Upload_Button}}},"blockImmersive":{{{Block_Clip_Button}}},"blockShorts":{{{Block_Shorts_Button}}},"debug":{{{Debug_Mode}}}}"
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&ack.*,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/b333b/yt-adblocking-module/main/Script/Youtube/youtube.request.js?v=893d2b70,argument="{"captionLang":"{{{Subtitle_Translation_Language}}}"}"
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/b333b/yt-adblocking-module/main/Script/Youtube/youtube.request.js?v=893d2b70

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com
